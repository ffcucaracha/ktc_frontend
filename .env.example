APP_ENV=local
APP_NAME=ktc_frontend
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://trainer:trainer@postgres:5432/trainer
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=change-me-in-local-development-only-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
COOKIE_SECURE=false
SIMULATION_GATEWAY_MODE=mock
SIMULATION_API_BASE_URL=http://simulation-service:8080
SIMULATION_WS_BASE_URL=ws://simulation-service:8080
SIMULATION_API_KEY=change-me
KTC_API_BASE_URL=http://ktc-backend:8000
SIMULATION_CONNECT_TIMEOUT_SECONDS=3
SIMULATION_READ_TIMEOUT_SECONDS=10
SIMULATION_TELEMETRY_ENABLED=true
SIMULATION_TELEMETRY_INTERVAL_SECONDS=2
SIMULATION_TELEMETRY_DISCOVERY_INTERVAL_SECONDS=1

POSTGRES_DB=trainer
POSTGRES_USER=trainer
POSTGRES_PASSWORD=trainer
POSTGRES_HOST_PORT=55439
DOCKER_NETWORK_SUBNET=10.50.2.0/24
KTC_HOST_PORT=8001

VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/ws/v1

E2E_ADMIN_USERNAME=e2e-admin
E2E_ADMIN_PASSWORD=change-me-e2e-admin-password
E2E_OPERATOR_USERNAME=e2e-operator
E2E_OPERATOR_PASSWORD=change-me-e2e-operator-password
